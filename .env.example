# Copy via `make dev-env` (generates real random values). Secrets come from env/vault only.
FTL_SIGNING_KEY=            # base64 32-byte Ed25519 seed
FTL_VERIFY_KEYS_EXTRA=      # comma-separated base64 public keys of rotated-out signing keys
FTL_JWT_SECRET=
FTL_DATA_ROOT=              # defaults to repo root; cards live under data/
FTL_ENABLE_DOCS=true
